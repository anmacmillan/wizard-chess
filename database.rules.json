{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$id": {
        ".read": "$id.length >= 6 && $id.length <= 24",
        ".write": "$id.length >= 6 && $id.length <= 24",
        ".validate": "newData.hasChildren(['m', 'w', 'b']) && newData.child('m').isString() && newData.child('m').val().length < 3000"
      }
    },
    "tanks": {
      "$id": {
        ".read": "$id.length >= 6 && $id.length <= 24",
        ".write": "$id.length >= 6 && $id.length <= 24",
        ".validate": "newData.hasChildren(['p', 'seed', 'round'])"
      }
    },
    "ttb": {
      "$id": {
        ".read": "$id.length == 6",
        ".write": "$id.length == 6",
        ".validate": "newData.hasChildren(['name', 'stars'])"
      }
    },
    "wcp": {
      "$id": {
        ".read": "$id.length >= 3 && $id.length <= 12",
        ".write": "$id.length >= 3 && $id.length <= 12"
      }
    }
  }
}
